{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "converting-md",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-19",
  "build": {
    "command": "npm run build:web"
  },
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "converting_md",
      "database_id": "426f6010-a165-4951-ad3d-13acad99e476"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "058485c020954ad8905c89eff79bbedc"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "REQUIRE_AUTH": "false",
    "ALLOW_ANON": "true",
    "DISABLE_BROWSER": "false",
    "DISABLE_IMAGE_CONVERSION": "true",
    "DEFAULT_CACHE_TTL_SECONDS": "86400",
    "MAX_SOURCE_BYTES": "2097152",
    "MAX_OUTPUT_BYTES": "2097152",
    "MAX_BROWSER_MS_PER_REQUEST": "10000",
    "GLOBAL_DAILY_BROWSER_MS_LIMIT": "600000",
    "GLOBAL_MONTHLY_BROWSER_MS_LIMIT": "36000000",
    "GLOBAL_DAILY_IMAGE_LIMIT": "50",
    "GLOBAL_MONTHLY_IMAGE_LIMIT": "500",
    "TYPESAFE_MODEL": "jev-1.14.0",
    "DISABLE_FRANKENSURF": "false",
    "FRANKENSURF_URL": "https://surf.converting.md",
    "FRANKENSURF_TIMEOUT_MS": "60000",
    "GLOBAL_DAILY_FRANKENSURF_LIMIT": "300",
    "GLOBAL_MONTHLY_FRANKENSURF_LIMIT": "5000"
  }
}
