{
  "name": "converting-md",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.14.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build:web": "tsx scripts/build-web.ts",
    "db:migrate": "wrangler d1 migrations apply converting_md",
    "db:migrate:local": "wrangler d1 migrations apply converting_md --local",
    "deploy:preflight": "tsx scripts/check-deploy-config.ts",
    "install:deploy-runner": "node scripts/install-deploy-runner.mjs",
    "predeploy": "npm run deploy:preflight",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "HOME=/tmp wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "create-local-key": "tsx scripts/create-local-key.ts",
    "smoke:health": "tsx scripts/smoke-health.ts",
    "check:env-hygiene": "tsx scripts/check-env-hygiene.ts",
    "check:prd-docs": "tsx scripts/check-prd-docs.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "check:file-lines": "tsx scripts/check-file-lines.ts",
    "check": "npm run typecheck && npm run test && npm run check:file-lines",
    "verify:release": "npm run check && npm run check:env-hygiene && npm run check:prd-docs && npm --cache /tmp/npm-cache audit && npm run deploy:dry-run && npm run smoke:health"
  },
  "dependencies": {
    "entities": "^8.0.0",
    "hono": "^4.12.19",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^25.9.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.2"
  },
  "overrides": {
    "ws": "^8.20.1"
  }
}
